PORT=8000
ADMIN_USERNAME=Administrator
ADMIN_PASSWORD=replace-me
JWT_SECRET=replace-with-a-long-random-secret
# Use different credentials so the server can authenticate each device class.
# ROBOT_TOKEN must match the robot controller config.h ROBOT_TOKEN.
# PUMP_TOKEN must match the ESP32-C3 pump config.h PUMP_TOKEN.
ROBOT_TOKEN=replace-with-a-long-random-robot-token
PUMP_TOKEN=replace-with-a-different-long-random-pump-token
DOMAIN=https://crophealth.dpdns.org
# Optional
TUNNEL_CMD=
DUCKDNS_TOKEN=
CHR_DB_PATH=./db/chr.db

# ---- Web app (the chrclient web build this server publishes) ----------------
# On startup the server looks at the chrclient release published by its CI and
# keeps public/ up to date. Nothing is downloaded when the newest build is
# already on disk. Leave these as they are unless you fork the app.
WEBAPP_ENABLED=true
WEBAPP_REPO=AlexaInc/chrclient
WEBAPP_RELEASE_TAG=latest
# Optional
# GITHUB_TOKEN=            # only needed if the app repository is private
# WEBAPP_ROOT=public
# WEBAPP_CHECK_INTERVAL_MS=0   # 0 = check once at startup (e.g. 3600000 = hourly)
